// Configuração do Worker (Wrangler + Vite plugin v1).
// Mudou algo aqui? Rode `npm run cf-typegen` para atualizar os tipos em worker-configuration.d.ts.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-cloudflare-template",
  // Data de compatibilidade do runtime. Mantenha atual.
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  // Entrada própria: o handler do TanStack Start + cron + a classe do Durable Object.
  "main": "src/server.ts",
  // Logs e traces no painel da Cloudflare.
  "observability": {
    "enabled": true
  },
  // Sobe os source maps no deploy: erros em produção apontam para o código-fonte.
  "upload_source_maps": true,
  // Arquivos estáticos (o plugin do Vite preenche a pasta sozinho).
  // Páginas pré-renderizadas saem como `/blog/index.html`; sem barra final na URL.
  "assets": {
    "html_handling": "drop-trailing-slash"
  },
  // Banco D1, acessado via Drizzle (src/db). Troque "REPLACE_ME" pelo ID real
  // que o `wrangler d1 create` mostrar, antes do deploy. No dev, o banco é local.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanstack-cloudflare-template-db",
      "database_id": "REPLACE_ME",
      "migrations_dir": "drizzle"
    }
  ],
  // Armazenamento de arquivos (R2).
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tanstack-cloudflare-template-files"
    }
  ],
  // Durable Object `Counter` (classe exportada em src/server.ts).
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER",
        "class_name": "Counter"
      }
    ]
  },
  // Cria a classe do Durable Object com armazenamento SQLite. Nunca edite uma
  // migração já publicada: classe nova = nova entrada com outra `tag`.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Counter"]
    }
  ],
  // Rate limit por IP nos endpoints públicos de escrita (login e demos): 5 por minuto.
  // `namespace_id` é um inteiro (como texto) único na conta; `period` só aceita 10 ou 60.
  // Uso: src/lib/rate-limit.ts (falha aberta se o binding não existir).
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Cron (UTC): chama o scheduled() de src/server.ts todo dia às 03:00.
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  // Variáveis em texto (não secretas). Troque pela URL pública ao publicar.
  // Segredos NÃO entram aqui: no dev vêm do .dev.vars; em produção, de `wrangler secret`.
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:3000"
  }
  // Cloudflare Email Service (opcional, plano Workers Paid, domínio verificado em
  // Compute → Email Service → Email Sending). Descomente, defina EMAIL_FROM com um
  // endereço do domínio verificado e src/lib/email.ts passa a usar este binding
  // quando RESEND_API_KEY não existir. (Lembre da vírgula depois de "vars".)
  // "send_email": [{ "name": "EMAIL" }]
}
